{
  "name": "engmarq-gerador-propostas",
  "version": "1.0.0",
  "description": "Gerador de Propostas Comerciais - EngMarq Solution",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:v2": "vite --open /gerador-de-proposta/v2.html",
    "dev:v2:quality": "vite --open /gerador-de-proposta/v2-quality-lab.html",
    "test:v2": "node scripts/test-v2-all.mjs",
    "test:v2:unit": "node --test tests/v2.test.mjs tests/v2-editor.test.mjs tests/v2-regression.test.mjs tests/v2-architecture.test.mjs",
    "test:v2:regression": "node scripts/test-v2-regression.mjs",
    "test:v2:update-baselines": "node scripts/test-v2-regression.mjs --update-baselines",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "propostas",
    "pdf",
    "typescript",
    "gerador"
  ],
  "author": "EngMarq Solution",
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@supabase/supabase-js": "^2.103.3",
    "pagedjs": "0.4.3"
  }
}
